{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.chitty.cc/schemas/cloudflare-registry-projection.schema.json",
  "title": "CloudflareRegistryProjection",
  "description": "Registry projection of Cloudflare deployed state. Validates registry-shaped identity, relationships, posture, and drift metadata while delegating object vocabulary to ChittySchema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "workKey", "generatedAt", "schemaRef", "records", "relationships", "drift"],
  "properties": {
    "manifestVersion": { "type": "string", "const": "0.1.0" },
    "workKey": { "type": "string", "const": "chittyregistry-cloudflare-governance" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceMode": { "type": "string", "enum": ["read_only_inventory", "governed_intent", "reconciliation_preview"] },
    "schemaRef": {
      "type": "string",
      "const": "https://schema.chitty.cc/infrastructure/cloudflare-governance.schema.json"
    },
    "sourceAccountRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/recordEnvelope" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "drift": {
      "type": "array",
      "items": { "$ref": "#/$defs/driftFinding" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "canonicalRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:/-]*$",
      "minLength": 3
    },
    "recordEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalId", "objectClass", "record", "registryPosture", "provenance"],
      "properties": {
        "canonicalId": { "$ref": "#/$defs/canonicalRef" },
        "objectClass": {
          "type": "string",
          "enum": [
            "access_application",
            "access_policy",
            "trust_domain",
            "route_domain_attachment",
            "mcp_surface",
            "service_binding",
            "credential_reference"
          ]
        },
        "record": {
          "type": "object",
          "description": "Payload conforming to the ChittySchema Cloudflare governance contract. Runtime validation must resolve schemaRef rather than duplicating the object vocabulary here."
        },
        "registryPosture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonicality", "verificationState", "disposition"],
          "properties": {
            "canonicality": { "type": "string", "enum": ["canonical", "projection", "alias", "candidate", "unknown"] },
            "verificationState": { "type": "string", "enum": ["observed", "verified", "conflicted", "stale", "unknown"] },
            "disposition": { "type": "string", "enum": ["keep", "merge", "replace", "alias", "retire", "hold"] },
            "canonicalTargetRef": { "$ref": "#/$defs/canonicalRef" },
            "decisionRef": { "type": "string", "minLength": 1 }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceSystem", "sourceObjectType", "sourceObjectId", "observedAt", "collector"],
          "properties": {
            "sourceSystem": { "type": "string", "const": "cloudflare" },
            "sourceObjectType": { "type": "string", "minLength": 1 },
            "sourceObjectId": { "type": "string", "minLength": 1 },
            "observedAt": { "type": "string", "format": "date-time" },
            "collector": { "type": "string", "minLength": 1 },
            "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationshipId", "type", "fromRef", "toRef", "purpose", "verificationState"],
      "properties": {
        "relationshipId": { "$ref": "#/$defs/canonicalRef" },
        "type": {
          "type": "string",
          "enum": [
            "protects",
            "routes_to",
            "attached_to",
            "member_of",
            "calls",
            "bound_to",
            "authenticated_by",
            "issued_by",
            "managed_by",
            "owned_by",
            "aliases",
            "supersedes"
          ]
        },
        "fromRef": { "$ref": "#/$defs/canonicalRef" },
        "toRef": { "$ref": "#/$defs/canonicalRef" },
        "purpose": { "type": "string", "minLength": 1 },
        "allowedOperations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "verificationState": { "type": "string", "enum": ["observed", "verified", "conflicted", "unknown"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "driftFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "kind", "severity", "subjectRefs", "observedState", "requiredAction", "status"],
      "properties": {
        "findingId": { "$ref": "#/$defs/canonicalRef" },
        "kind": {
          "type": "string",
          "enum": [
            "authority_collision",
            "attachment_overlap",
            "semantic_redundancy",
            "policy_duplicate",
            "policy_scope_drift",
            "unjustified_bypass",
            "overbroad_trust",
            "missing_intent",
            "stale_alias",
            "missing_owner",
            "runtime_schema_mismatch"
          ]
        },
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "informational"] },
        "subjectRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/canonicalRef" }, "uniqueItems": true },
        "observedState": { "type": "string", "minLength": 1 },
        "intendedState": { "type": "string" },
        "requiredAction": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["open", "accepted", "planned", "resolved", "false_positive", "hold"] },
        "decisionRef": { "type": "string" },
        "rollbackRequired": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "relationshipCount": { "type": "integer", "minimum": 0 },
        "driftCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "blockingFindingRefs": { "type": "array", "items": { "$ref": "#/$defs/canonicalRef" }, "uniqueItems": true }
      }
    }
  }
}
