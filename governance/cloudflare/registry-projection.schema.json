{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.chitty.cc/schemas/cloudflare-registry-projection.schema.json",
  "title": "CloudflareRegistryProjection",
  "description": "Projection envelope for Cloudflare observations and governed records. ChittyRegistry owns projection mechanics only; ontology, lifecycle vocabulary, relationships, and finding semantics are referenced from ChittyCanon and ChittySchema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "workKey", "generatedAt", "sourceMode", "records"],
  "properties": {
    "manifestVersion": { "type": "string", "const": "0.2.0" },
    "workKey": { "type": "string", "const": "chittyregistry-cloudflare-governance" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceMode": {
      "type": "string",
      "description": "Reference to a ChittySchema-governed execution mode value, not a registry-authored ontology term."
    },
    "schemaRefs": {
      "type": "array",
      "items": { "type": "string", "format": "uri-reference" },
      "uniqueItems": true
    },
    "sourceAccountRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/recordEnvelope" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationshipProjection" }
    },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observationProjection" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "recordRef": {
      "type": "string",
      "minLength": 1
    },
    "termRef": {
      "type": "string",
      "description": "ChittyCanon ontology term ID or formal proposal ID.",
      "minLength": 1
    },
    "schemaRef": {
      "type": "string",
      "format": "uri-reference"
    },
    "recordEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordRef", "record", "provenance"],
      "properties": {
        "recordRef": { "$ref": "#/$defs/recordRef" },
        "recordSchemaRef": { "$ref": "#/$defs/schemaRef" },
        "objectClassTermRef": { "$ref": "#/$defs/termRef" },
        "record": {
          "type": "object",
          "description": "A governed ChittyRegister/ChittySchema record or a Cloudflare observation. Registry does not define the record vocabulary.",
          "additionalProperties": true
        },
        "projection": {
          "type": "object",
          "description": "Projection-only metadata. Ontology-bearing status values must be represented by upstream term/schema references.",
          "additionalProperties": false,
          "properties": {
            "lifecycleRef": { "$ref": "#/$defs/termRef" },
            "dispositionRef": { "$ref": "#/$defs/termRef" },
            "canonicalTargetRef": { "$ref": "#/$defs/recordRef" },
            "decisionRef": { "type": "string", "minLength": 1 },
            "verifiedAt": { "type": "string", "format": "date-time" }
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSystem", "sourceObjectType", "sourceObjectId", "observedAt", "collector"],
      "properties": {
        "sourceSystem": { "type": "string", "minLength": 1 },
        "sourceObjectType": { "type": "string", "minLength": 1 },
        "sourceObjectId": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "collector": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "relationshipProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationshipRef", "relationshipTermRef", "fromRef", "toRef", "provenance"],
      "properties": {
        "relationshipRef": { "$ref": "#/$defs/recordRef" },
        "relationshipTermRef": { "$ref": "#/$defs/termRef" },
        "fromRef": { "$ref": "#/$defs/recordRef" },
        "toRef": { "$ref": "#/$defs/recordRef" },
        "purpose": { "type": "string" },
        "allowedOperations": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "verificationRef": { "$ref": "#/$defs/termRef" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "observationProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationRef", "subjectRefs", "observedState", "provenance"],
      "properties": {
        "observationRef": { "$ref": "#/$defs/recordRef" },
        "observationTermRef": { "$ref": "#/$defs/termRef" },
        "subjectRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/recordRef" },
          "uniqueItems": true
        },
        "observedState": { "type": "string", "minLength": 1 },
        "intendedState": { "type": "string" },
        "severityRef": { "$ref": "#/$defs/termRef" },
        "statusRef": { "$ref": "#/$defs/termRef" },
        "requiredAction": { "type": "string" },
        "decisionRef": { "type": "string" },
        "rollbackRequired": { "type": "boolean" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordCount": { "type": "integer", "minimum": 0 },
        "relationshipCount": { "type": "integer", "minimum": 0 },
        "observationCount": { "type": "integer", "minimum": 0 },
        "blockingObservationRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/recordRef" },
          "uniqueItems": true
        }
      }
    }
  }
}
