# ChittyRegistry — example environment file.
# Copy to `.env` and fill in via the ChittySecrets / ChittyConnect broker.
# Never commit real values; `.env` is gitignored.

# --- Notion integration (NotionSyncService, notion-webhooks, scripts/notion-*) ---
# Notion internal integration token. Format: secret_<43 base62 chars>.
NOTION_TOKEN=
# Page under which synced databases are created.
NOTION_PARENT_PAGE_ID=
# Shared secret used to verify inbound Notion webhook signatures.
NOTION_WEBHOOK_SECRET=

# --- Notion database ids, one per mirrored registry ---
CHITTYREGISTRY_NOTION_DB_ID=
CHITTYSCHEMA_NOTION_DB_ID=
CHITTYGOV_NOTION_DB_ID=
CHITTYCHRONICLE_NOTION_DB_ID=

# --- ChittyOS service auth ---
# Service token for id.chitty.cc. Brokered — do not paste a value here.
CHITTY_ID_TOKEN=
